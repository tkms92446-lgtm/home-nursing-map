# ===== サーバー側のみ（NEXT_PUBLIC_ を付けない＝ブラウザに露出しない） =====
# PostgreSQL + PostGIS（ローカル or Supabase 無料枠の接続文字列）
DATABASE_URL=postgres://hnm:hnm@localhost:5432/hnm
# テスト用DB（npm test で使用。中身は毎回作り直されます）
TEST_DATABASE_URL=postgres://hnm:hnm@localhost:5432/hnm_test

# Geocoding プロバイダの優先順（カンマ区切り）。APIキー不要の組み合わせが既定
#   gsi      : 国土地理院 住所検索API（無料・キー不要・要レート制限）
#   geolonia : Geolonia japanese-addresses（CC BY 4.0, 町丁目/街区代表点, ファイルキャッシュ）
GEOCODER_PROVIDERS=gsi,geolonia
GEOCODER_GSI_INTERVAL_MS=1000
# GEOLONIA_API_BASE=https://raw.githubusercontent.com/geolonia/japanese-addresses/master/api
# GEOLONIA_GAIKU_BASE=https://geolonia.github.io/japanese-addresses/api
DEFAULT_PREFECTURE=大阪府

# 管理画面 /admin の Basic 認証（未設定ならローカル開発用に認証なし）
ADMIN_USER=admin
ADMIN_PASSWORD=

# ===== ブラウザに公開される設定 =====
# 地図スタイル: gsi-pale（地理院タイル淡色, 既定）/ gsi-std / osm / MapLibre スタイルJSONのURL
NEXT_PUBLIC_MAP_STYLE=gsi-pale
# 初期表示位置（大阪市天王寺区周辺）
NEXT_PUBLIC_DEFAULT_LAT=34.6545
NEXT_PUBLIC_DEFAULT_LNG=135.5190
NEXT_PUBLIC_DEFAULT_ZOOM=13
